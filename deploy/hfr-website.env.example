# Copy to /etc/hfr-website.env and fill in. Read by the systemd unit.
# Keep this file root-only (chmod 600); it holds the secret key and SMTP password.

# --- Required ---
DJANGO_SECRET_KEY=CHANGE-ME-run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.org,www.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.org,https://www.example.org

# --- Society contact address (store orders, sponsorship, donations) ---
HFR_CONTACT_EMAIL=hfr@example.org

# --- Outgoing email (password resets). Any SMTP relay works; Brevo free tier is fine. ---
DJANGO_EMAIL_HOST=smtp-relay.brevo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL="HFR <hfr@example.org>"

# --- Forum (leave unset for launch) ---
# HFR_FORUM_URL=
# HFR_DISCOURSE_CONNECT_SECRET=
